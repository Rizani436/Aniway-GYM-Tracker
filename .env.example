# Supabase Project URL & Anon Key (Dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Base URL aplikasi (untuk redirect OAuth Google & email konfirmasi)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma Database Connection
# Gunakan Transaction Pooler (port 6543, pgbouncer=true) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Gunakan Session Pooler (port 5432) untuk DIRECT_URL (kebutuhan migrasi Prisma)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
