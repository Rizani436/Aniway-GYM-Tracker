# Supabase Project URL & Anon Key (Dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Base URL aplikasi (untuk redirect OAuth Google & email konfirmasi)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma Database Connection
# Gunakan Session Pooler Supavisor (port 5432).
# PENTING: JANGAN tambahkan ?pgbouncer=true. Pada Supavisor (pooler Supabase generasi
# sekarang) parameter itu menghambat connection reuse sehingga SETIAP query memakan
# ~1.5 detik, bukan ~0.29 detik. Terukur lewat scripts/db-find-best.mjs.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# DIRECT_URL dipakai Prisma untuk migrasi (db push / migrate).
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
